# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Host port used to reach the app (http://localhost:$APP_PORT).
APP_PORT=4000
# Port the Phoenix server listens on inside the container.
PORT=4000
# Host used by Phoenix to build URLs. Use "localhost" for local compose.
PHX_HOST=localhost
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=srJy/fmwgR8mpYaJu1o8/88LCkL2i8w7tcNAZGYk7AfRrp9/zkcNpm4EAGL/90Rf
# Number of database connections held by the app.
POOL_SIZE=10
# Run "MiniTask.Release.migrate" automatically when the container starts.
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mini_task_prod
# Host port used to reach Postgres (for psql/GUI clients).
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# The app builds DATABASE_URL from the POSTGRES_* values above pointing at the
# "db" service. Uncomment to use an external database instead.
# DATABASE_URL=ecto://user:pass@host:5432/database
# Set to true/1 to enable IPv6 socket options for the database connection.
# ECTO_IPV6=false
