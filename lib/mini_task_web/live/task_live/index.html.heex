<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="text-left">
    <.header>
      Tasks
      <:subtitle>Tasks you created or were assigned to.</:subtitle>
      <:actions>
        <.button phx-click="open_task_modal" variant="primary">New task</.button>
      </:actions>
    </.header>
  </div>

  <div
    :if={@task_count == 0}
    class="rounded-box border border-dashed border-base-300 p-10 text-center"
  >
    <.icon name="hero-clipboard-document-list" class="mx-auto size-10 text-base-content/40" />
    <p class="mt-4 font-semibold">No tasks yet</p>
    <p class="mt-1 text-sm text-base-content/70">
      Tasks you create or get assigned to will appear here.
    </p>
  </div>

  <div :if={@task_count > 0} class="overflow-x-auto">
    <.table id="tasks" rows={@streams.tasks} row_item={&row_item/1}>
      <:col :let={task} label="Task">
        <div class="font-semibold">{task.title}</div>
        <div :if={task.description} class="line-clamp-2 text-sm text-base-content/70">
          {task.description}
        </div>
      </:col>

      <:col :let={task} label="Status">
        <span class={["badge badge-sm", status_badge(task.status)]}>
          {status_label(task.status)}
        </span>
      </:col>

      <:col :let={task} label="Assignees">
        <div :if={task.assignees == []} class="text-sm text-base-content/50">
          Unassigned
        </div>

        <div
          :if={task.assignees != []}
          class="flex items-center -space-x-2"
          title={assignee_names(task.assignees)}
        >
          <span class="sr-only">{assignee_names(task.assignees)}</span>
          <.user_avatar :for={user <- Enum.take(task.assignees, 4)} user={user} />
          <span
            :if={length(task.assignees) > 4}
            class="inline-flex size-8 items-center justify-center rounded-full bg-base-200 text-xs font-semibold text-base-content ring-2 ring-base-100"
          >
            +{length(task.assignees) - 4}
          </span>
        </div>
      </:col>

      <:action :let={task}>
        <%= if task.user_id == @current_scope.user.id do %>
          <button
            type="button"
            class="link link-info text-sm"
            phx-click="edit_task"
            phx-value-id={task.id}
          >
            Edit
          </button>

          <button
            type="button"
            class="link link-error text-sm"
            phx-click="delete"
            phx-value-id={task.id}
            data-confirm="Are you sure you want to delete this task?"
          >
            Delete
          </button>
        <% else %>
          <span class="text-sm text-base-content/40">View only</span>
        <% end %>
      </:action>
    </.table>
  </div>

  <div
    :if={@show_task_modal}
    class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
  >
    <div
      class="w-full max-w-2xl rounded-3xl border border-base-300 bg-base-100 p-6 shadow-2xl sm:p-8"
      role="dialog"
      aria-modal="true"
      phx-click-away="close_task_modal"
      phx-window-keydown="close_task_modal"
      phx-key="Escape"
    >
      <.header>
        {if assigns[:editing_task], do: "Edit task", else: "Create a task"}
        <:subtitle>
          {if assigns[:editing_task],
            do: "Update the details below.",
            else: "Fill in the details below."}
        </:subtitle>
      </.header>

      <.form for={@form} id="task-form" phx-submit="save_task" class="mt-6 space-y-6">
        <.input
          field={@form[:title]}
          type="text"
          label="Task title"
          required
          phx-mounted={JS.focus()}
        />

        <.input
          field={@form[:description]}
          type="textarea"
          label="Description"
          rows="5"
        />

        <.input
          field={@form[:status]}
          type="select"
          label="Status"
          options={[
            {"Pending", "pending"},
            {"In progress", "in_progress"},
            {"Done", "done"},
            {"Cancelled", "cancelled"}
          ]}
        />

        <div class="space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p id="task-assignees-label" class="text-sm font-medium">Assignees</p>
              <p class="text-xs text-base-content/60">
                Select the people responsible for this task.
              </p>
            </div>
            <span class="badge badge-ghost badge-sm">{length(@users)} people</span>
          </div>

          <div
            role="group"
            aria-labelledby="task-assignees-label"
            class="max-h-56 overflow-y-auto rounded-2xl border border-base-300 bg-base-100"
          >
            <label
              :for={user <- @users}
              class="flex cursor-pointer items-center gap-3 border-b border-base-200 px-3 py-2.5 last:border-0 hover:bg-base-200/60"
            >
              <input
                type="checkbox"
                name="task[assignee_ids][]"
                value={user.id}
                checked={
                  assigns[:editing_task] &&
                    Enum.any?(
                      assigns[:editing_task].assignees,
                      fn assignee -> assignee.id == user.id end
                    )
                }
                class="checkbox checkbox-sm"
              />
              <.user_avatar user={user} size="size-9" />
              <span class="min-w-0 flex-1 truncate text-sm">{user.email}</span>
            </label>

            <p :if={@users == []} class="px-4 py-5 text-center text-sm text-base-content/60">
              No people available yet.
            </p>
          </div>
        </div>

        <div class="flex justify-end gap-3">
          <button type="button" class="btn btn-ghost" phx-click="close_task_modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">
            {if assigns[:editing_task], do: "Save changes", else: "Create task"}
          </button>
        </div>
      </.form>
    </div>
  </div>
</Layouts.app>
